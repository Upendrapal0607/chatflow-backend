{
    "name": "chatflow-backend",
    "version": "1.0.0",
    "description": "Chat backend with Node.js, strict TypeScript, Koa, PostgreSQL, and Firebase Firestore",
    "main": "build/app.js",
    "engines": {
        "node": ">=22.16.0"
    },
    "scripts": {
        "dev": "node --no-deprecation -r dotenv/config -r ts-node/register src/app.ts",
        "dev:watch": "nodemon --watch src --ext ts,json --exec \"node --no-deprecation -r dotenv/config -r ts-node/register src/app.ts\"",
        "clean": "rimraf build",
        "build": "npm run clean && tsc",
        "start": "node -r dotenv/config build/app.js",
        "type-check": "tsc --noEmit",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "lint:check": "eslint \"src/**/*.ts\" --max-warnings 0",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "jest",
        "validate": "npm run lint:check && npm run type-check && npm test"
    },
    "dependencies": {
        "@koa/router": "^13.1.0",
        "bcrypt": "^6.0.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.44.7",
        "firebase-admin": "^13.6.0",
        "jsonwebtoken": "^9.0.2",
        "koa": "^3.0.0",
        "koa-body": "^6.0.1",
        "koa-qs": "^3.0.0",
        "pg": "^8.16.3",
        "radash": "^12.1.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^9.33.0",
        "@types/bcrypt": "^5.0.2",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/koa": "^2.15.0",
        "@types/koa-qs": "^3.0.3",
        "@types/node": "^22.15.0",
        "@types/pg": "^8.15.5",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.39.1",
        "@typescript-eslint/parser": "^8.39.1",
        "drizzle-kit": "^0.31.4",
        "eslint": "^9.33.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "rimraf": "^6.1.2",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.2"
    }
}
