# Application
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
SKIP_DB_PREFLIGHT=false
CORS_ORIGIN=*

# PostgreSQL (Neon / PostgreSQL connection pool)
DATABASE_URL=postgresql://user:password@host/chatflow?sslmode=verify-full&channel_binding=require
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Firebase Firestore (Messages, read receipts, last seen)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Option A: Inline service account credentials (recommended for cloud production)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Option B: Path to service account JSON file (e.g. ./creds.json for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option C: Raw JSON or base64-encoded service account JSON
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option D: Local Firestore emulator (e.g. localhost:8080)
FIRESTORE_EMULATOR_HOST=
