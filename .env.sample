# Application
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
SKIP_DB_PREFLIGHT=false

# PostgreSQL (Relational DB for users, chats, chat_members)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatflow
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Firebase Firestore (Messages, read receipts, last seen)
FIREBASE_PROJECT_ID=chatflow-local
# Option A: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option B: Inline service account credentials
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Option C: Local Firestore emulator (e.g. localhost:8080)
FIRESTORE_EMULATOR_HOST=
